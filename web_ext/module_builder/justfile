# Command runner for the Steenrod module builder.
# Requires `just` >= 1.5.

set shell := ["bash", "-c"]

WASM_TARGET := "wasm32-unknown-unknown"
NAME        := "module_builder"
WASM_LIB    := "target/" + WASM_TARGET + "/release/" + NAME + ".wasm"
WASM_OUT    := "dist"
WASM_FILE   := WASM_OUT + "/" + NAME + "_wasm_bg.wasm"
MODULES     := "../../ext/steenrod_modules"

# Build the wasm and assemble the site (default recipe).
all: wasm-bindgen-step
    cp files/* {{WASM_OUT}}
    cp -r {{MODULES}} {{WASM_OUT}}
    just manifest

# A static file server cannot list a directory, so the library needs an index. Recording the type and
# prime as well lets the page list only the modules it can actually open.
manifest:
    #!/usr/bin/env python3
    import glob, json, os
    modules = []
    for path in sorted(glob.glob("{{WASM_OUT}}/steenrod_modules/*.json")):
        with open(path) as f:
            spec = json.load(f)
        modules.append(
            {
                "name": os.path.basename(path)[: -len(".json")],
                "type": spec.get("type"),
                "p": spec.get("p"),
            }
        )
    with open("{{WASM_OUT}}/modules.json", "w") as f:
        json.dump(modules, f, indent=1)
    print(f"indexed {len(modules)} modules")

test:
    cargo test

lint: lint-fmt lint-clippy

# Separate from `lint-clippy` because rustfmt.toml uses nightly-only options, so only a nightly
# rustfmt produces the formatting this crate is checked against.
lint-fmt:
    cargo fmt -- --check

lint-clippy:
    cargo clippy --lib --target {{WASM_TARGET}}
    cargo clippy --all-targets

setup-wasm:
    #!/usr/bin/env bash
    set -euo pipefail
    # Install wasm-bindgen-cli at the exact version the crate resolves to: the generated glue and the
    # CLI share an unstable schema and must be version-matched, so an unpinned install can drift out
    # of sync and break the build. Deriving the version keeps this in step with the crate.
    # `--target all` so this keeps working even if wasm-bindgen becomes a wasm32-only dependency (a
    # host-target `cargo tree` would print nothing).
    version="$(cargo tree --target all --package wasm-bindgen --depth 0 --prefix none | head -1 | awk '{gsub(/^v/,"",$2); print $2}')"
    test -n "$version" || { echo "could not determine wasm-bindgen version" >&2; exit 1; }
    cargo install wasm-bindgen-cli --version "$version" --debug
    rustup target add wasm32-unknown-unknown

wasm-lib:
    cargo build --lib --target {{WASM_TARGET}} --release

wasm-bindgen-step: wasm-lib
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="$HOME/.cargo/bin:$PATH"
    mkdir -p {{WASM_OUT}}
    wasm-bindgen --no-typescript --target no-modules --out-dir {{WASM_OUT}} --out-name {{NAME}}_wasm {{WASM_LIB}}
    wasm-opt -O3 {{WASM_FILE}} -o {{WASM_FILE}} || true

serve: all
    python3 -m http.server --directory {{WASM_OUT}} 8081

clean:
    rm -rf {{WASM_OUT}} target
